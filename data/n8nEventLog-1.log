ogress apa saja\\\" atau minta daftar/riwayat, gunakan get_progress. Jika ambigu, panggil keduanya. Jangan tampilkan token/header/JSON mentah. Tolak permintaan data user lain.\\nHuman: Berapa nilai magang saya?\"],\"options\":{\"api_key\":{\"lc\":1,\"type\":\"secret\",\"id\":[\"GROQ_API_KEY\"]},\"model\":\"openai/gpt-oss-120b\",\"temperature\":0.7},\"response\":{\"response\":{\"generations\":[[{\"text\":\"\",\"generationInfo\":{\"finish_reason\":\"tool_calls\"}}]]},\"tokenUsage\":{\"completionTokens\":30,\"promptTokens\":794,\"totalTokens\":824}}}"}}
